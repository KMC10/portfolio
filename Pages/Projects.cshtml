@page
@model KMC.Portfolio.Pages.ProjectsModel
@{
    ViewData["Title"] = "Projects";
}

<section class="page-section">
    <div class="container">

        <div class="section-heading">
            <p class="section-label">MY WORK</p>
            <h1>Projects</h1>
        </div>

        <div class="projects-grid">

            <div class="project-card">
                <h2>Incident Management System</h2>

                <p>
                    A software system for managing fire-station incidents,
                    dispatch operations, users, stations, and emergency
                    response activities.
                </p>

                <div class="project-technologies">
                    <span>C#</span>
                    <span>VB.NET</span>
                    <span>ASP.NET</span>
                    <span>SQL Server</span>
                </div>
            </div>

            <div class="project-card">
                <h2>Dispatcher System</h2>

                <p>
                    A web-based system for managing transportation trips,
                    matching available vehicles with requests, and tracking
                    remaining capacity.
                </p>

                <div class="project-technologies">
                    <span>C#</span>
                    <span>ASP.NET Core</span>
                    <span>PostgreSQL</span>
                    <span>Entity Framework</span>
                </div>
            </div>

            <div class="project-card">
                <h2>Developer Portfolio</h2>

                <p>
                    A personal portfolio website built to showcase my
                    software development experience, technical skills,
                    projects, and professional background.
                </p>

                <div class="project-technologies">
                    <span>C#</span>
                    <span>ASP.NET Core</span>
                    <span>Razor Pages</span>
                    <span>HTML</span>
                    <span>CSS</span>
                </div>
            </div>

        </div>

    </div>
</section>