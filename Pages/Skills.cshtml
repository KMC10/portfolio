@page
@model KMC.Portfolio.Pages.SkillsModel
@{
    ViewData["Title"] = "Skills";
}

<section class="page-section">
    <div class="container">

        <div class="section-heading">
            <p class="section-label">TECHNICAL SKILLS</p>
            <h1>What I Work With</h1>
        </div>

        <div class="skills-grid">

            <div class="skill-card">
                <h2>Programming Languages</h2>
                <p>C#</p>
                <p>Java</p>
                <p>C / C++</p>
                <p>Python</p>
                <p>JavaScript</p>
            </div>

            <div class="skill-card">
                <h2>Frameworks &amp; Platforms</h2>
                <p>.NET</p>
                <p>ASP.NET Core</p>
                <p>Razor Pages</p>
                <p>Entity Framework</p>
            </div>

            <div class="skill-card">
                <h2>Databases</h2>
                <p>SQL Server</p>
                <p>MySQL</p>
                <p>PostgreSQL</p>
            </div>

            <div class="skill-card">
                <h2>Tools &amp; Technologies</h2>
                <p>Visual Studio</p>
                <p>Git</p>
                <p>GitLab</p>
                <p>Linux</p>
            </div>

        </div>

    </div>
</section>