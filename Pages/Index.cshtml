@page
@model IndexModel
@{
    ViewData["Title"] = "Home";
}

<section class="hero">

    <div class="hero-content">

        <div class="hero-text">

            <p class="hero-intro">HELLO, I'M</p>

            <h1>Khulani Dlamini</h1>

            <h2>Software Developer</h2>

            <p class="hero-description">
                I design and develop software applications that solve
                real-world problems using C#, .NET, Java, Python,
                databases, and modern web technologies.
            </p>

            <div class="hero-buttons">
                <a asp-page="/Projects" class="btn btn-primary">
                    View My Projects
                </a>

                <a asp-page="/Contact" class="btn btn-outline-primary">
                    Contact Me
                </a>
            </div>

        </div>

        <div class="hero-photo">

             <img src="~/images/profile.JPEG"
             alt="Khulani Dlamini"
             class="hero-profile-image" />

        </div>

    </div>

</section>